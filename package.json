{
	"name": "dsh-miniapp",
	"displayName": "DSH MiniApp",
	"description": "小程序 for DeepSeek Harness — AI-generated, self-contained single-file web tools you publish once and reuse forever. Ported from NomiFun Desktop.",
	"version": "0.3.0",
	"author": "gpmlimeng-cyber",
	"keywords": [
		"dsh-plugin",
		"deepseek-harness",
		"deepseek",
		"miniapp",
		"小程序",
		"generative-ui"
	],
	"type": "module",
	"engines": {
		"node": "^22.19.0 || >=24.0.0"
	},
	"main": "lib/index.js",
	"exports": {
		".": {
			"default": "./lib/index.js"
		},
		"./client": "./lib/client.js",
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"cordis.patch.yml",
		"README.md",
		"README.zh.md",
		"README.es.md",
		"README.pt.md",
		"README.hi.md",
		"LICENSE"
	],
	"license": "MIT",
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"inject": [
				"@deepseek-ai/dsh-client-ui-renderer",
				"@deepseek-ai/dsh-client-ui-sidebar",
				"@deepseek-ai/dsh-client-locale"
			],
			"platform": "web"
		}
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "^4.0.2",
		"@deepseek-ai/dsh-tools": ">=0.1.0-rc.8 <0.2.0",
		"@deepseek-ai/schemastery": "^3.18.2"
	},
	"packageManager": "pnpm@11.7.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gpmlimeng-cyber/dsh-miniapp.git"
	},
	"homepage": "https://github.com/gpmlimeng-cyber/dsh-miniapp#readme",
	"bugs": {
		"url": "https://github.com/gpmlimeng-cyber/dsh-miniapp/issues"
	},
	"scripts": {
		"test": "node --test test/smoke.test.mjs test/host.test.mjs test/client.test.mjs test/seat-contract.test.mjs"
	}
}
