{
  "name": "dsh-miniapp",
  "displayName": "DSH MiniApp",
  "description": "小程序 for DeepSeek Harness — AI-generated, self-contained single-file web tools you publish once and reuse forever. Ported from NomiFun Desktop.",
  "version": "0.2.0",
  "author": "limeng",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "miniapp",
    "小程序",
    "generative-ui"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.es.md",
    "README.pt.md",
    "README.hi.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "packageManager": "pnpm@11.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpmlimeng-cyber/dsh-miniapp.git"
  },
  "homepage": "https://github.com/gpmlimeng-cyber/dsh-miniapp#readme",
  "bugs": {
    "url": "https://github.com/gpmlimeng-cyber/dsh-miniapp/issues"
  }
}
